{
  "name": "@deepseek-ai/dsh-llm-copilot-acp",
  "version": "0.1.7-rc.3",
  "description": "GitHub Copilot CLI ACP Provider for DeepSeek Harness Desktop",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "acp",
    "github-copilot",
    "cordis"
  ],
  "author": "DeepSeek Harness Community",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "5.8.3"
  }
}
